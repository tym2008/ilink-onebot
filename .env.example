# ===== 日志 =====
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/ilink-onebot.log
LOG_ROTATION_SIZE=2 MB
LOG_RETENTION_COUNT=5
LOG_COMPRESSION=gz

# ===== 数据库（SQLite） =====
DATABASE_URL=sqlite+aiosqlite:///data/bridge.db

# ===== HTTP 客户端超时 =====
AIOHTTP_TIMEOUT_TOTAL=120
AIOHTTP_TIMEOUT_CONNECT=10
AIOHTTP_TIMEOUT_SOCK_READ=60

# ===== iLink 协议 =====
ILINK_API_BASE_URL=https://ilinkai.weixin.qq.com

# ===== OneBot v11 协议层 =====
ONEBOT_WS_HOST=0.0.0.0
ONEBOT_WS_PORT=6700
# 留空表示不校验 WS 连接
# ONEBOT_ACCESS_TOKEN=your-secret-token
ONEBOT_SELF_ID=10000
# 可选：反向 WS 客户端模式，本桥接主动连过去（与上面的 server 模式可同时启用）
# ONEBOT_REVERSE_WS_URL=ws://nonebot-host:8080/onebot/v11/ws

# ===== 媒体 HTTP 服务 =====
MEDIA_SERVE_HOST=0.0.0.0
MEDIA_SERVE_PORT=5701
# 部署在反向代理/NAT 后需要显式指定公网可访问 URL
# MEDIA_SERVE_PUBLIC_BASE_URL=http://your-domain.com:5701

# ===== 媒体缓存 =====
MEDIA_CACHE_DIR=data/media_cache
MEDIA_CACHE_TTL_SECONDS=3600
